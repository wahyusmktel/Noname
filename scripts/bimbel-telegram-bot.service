[Unit]
Description=Telegram Deployer Bot Daemon for Bimbel No Name
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/scripts
ExecStart=/usr/bin/python3 /var/www/scripts/telegram_deployer.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
